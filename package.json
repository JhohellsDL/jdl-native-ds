{
  "name": "jdl-native-ds",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "pnpm --filter @jdl/native-ds build",
    "build:ui": "pnpm --filter @jdl/native-ds build",
    "pack:ui": "pnpm --filter @jdl/native-ds pack",
    "build:lab": "vite build",
    "check:themes": "node --experimental-strip-types --test checks/themes.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jdl/native-ds": "workspace:*",
    "lucide-react-native": "1.70.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "buffer": "^6.0.3",
    "typescript": "~5.9.2",
    "vite": "^6.0.7"
  }
}
