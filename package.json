{
  "name": "jdl-native-ds",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "npm run build --workspace @jdl/native-ds",
    "build:ui": "npm run build --workspace @jdl/native-ds",
    "build:lab": "vite build",
    "check:themes": "node --experimental-strip-types --test checks/themes.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jdl/native-ds": "0.1.0",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "5.0.1",
    "lucide-react-native": "1.70.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.9.2",
    "vite": "^6.0.7"
  }
}
